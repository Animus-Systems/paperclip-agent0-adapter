# Agent Zero
A0_BASE_URL=http://localhost:50001
A0_API_KEY=your_a0_api_key_here
A0_TIMEOUT_MS=360000
A0_DEFAULT_CONTEXT_LIFETIME_HOURS=48
A0_RETRY_DELAY_MS=10000

# Adapter
PORT=4000
ADAPTER_SECRET=your_adapter_secret_here
CONTEXT_DB_PATH=./data/contexts.sqlite
LOG_LEVEL=info

# Paperclip callback signing
PAPERCLIP_WEBHOOK_SECRET=your_paperclip_webhook_secret_here
PAPERCLIP_CALLBACK_RETRY_BASE_MS=2000

# Budget guard
BUDGET_WARN_THRESHOLD=2
BUDGET_BLOCK_AT_ZERO=true

# Translation defaults
DEFAULT_COMPANY_MISSION=Deliver useful outcomes for the company.
DEFAULT_PROJECT_GOAL=Complete the current task effectively.
DEFAULT_AGENT_GOAL=Execute the assigned work autonomously.

# Cost extraction
COST_LOG_FETCH_COUNT=100
DEFAULT_MODEL_FOR_COST=minimax-m2.7
