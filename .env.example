# Agent Zero connection
A0_BASE_URL=http://localhost:5555/api/
A0_API_KEY=your_agent_zero_mcp_token_here
A0_TIMEOUT_MS=360000
A0_DEFAULT_CONTEXT_LIFETIME_HOURS=48
A0_RETRY_DELAY_MS=10000

# Paperclip connection (for fetching issues and posting comments)
PAPERCLIP_URL=http://server:3100
PAPERCLIP_API_KEY=your_paperclip_agent_jwt_here

# Adapter server
PORT=4000
ADAPTER_SECRET=none
CONTEXT_DB_PATH=./data/contexts.sqlite
LOG_LEVEL=info

# Cost extraction
COST_LOG_FETCH_COUNT=100
DEFAULT_MODEL_FOR_COST=minimax-m2.7
